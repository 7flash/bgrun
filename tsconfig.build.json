{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "allowImportingTsExtensions": false
  },
  "include": ["src/api.ts", "src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*test-snippet.ts"]
}
